*.py[cod]
.pytest_cache/
.mypy_cache/

.venv/
venv/
env/

.env
.env.local
db.sqlite3
db.sqlite3-journal
tmp_files/
staticfiles/
celerybeat-schedule*

.git/
.gitignore
