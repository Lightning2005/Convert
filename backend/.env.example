# Скопируйте в backend/.env — docker-compose подхватывает этот файл сам.
# Все переменные необязательны: без них поднимается локальная конфигурация.

# В продакшене ставьте 0 и обязательно задавайте DJANGO_SECRET_KEY: без ключа
# из окружения Django с DEBUG=0 откажется стартовать (ключ выше засвечен в git).
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=

# Реальный домен через запятую. По умолчанию разрешены localhost, 127.0.0.1 и
# имя сервиса web — этого хватает для локальной разработки.
DJANGO_ALLOWED_HOSTS=

# Источник фронтенда, если он живёт на отдельном домене: https://konvert.ru.
# При DEBUG=1 разрешены любые источники, в проде — только этот список.
CORS_ALLOWED_ORIGINS=

# /admin по умолчанию доступна только при DEBUG=1. Для prod-доступа раскомментируйте.
DJANGO_ENABLE_ADMIN=

# Путь к бинарникам poppler на Windows, если worker запускается хост-процессом.
# Внутри Docker не нужен: poppler-utils стоит в образе.
# POPPLER_PATH=E:\Study\App\poppler-26.02.0\Library\bin

# Кэш django: в нём метки «задача принята в очередь». compose по умолчанию
# использует вторую базу своего redis; Celery живёт в первой.
# DJANGO_CACHE_URL=redis://127.0.0.1:6379/1
