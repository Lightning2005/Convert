# Абсолютный адрес продакшена — нужен для canonical, og:url, robots.txt и sitemap.xml.
# Без него статические теги и файлы не генерируются.
VITE_SITE_URL=https://example.ru

# Строка из кабинета Яндекс.Reкламы для файла ads.txt (публикуется как есть).
# Формат: <домен сети>, <ID издателя>, DIRECT, <контрольный параметр>
VITE_ADS_TXT=yandex.com, pub-XXXXXXXXXXXXX, DIRECT, XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ID издателя из того же кабинета (pub-…, левое поле строки выше). Пока
# площадка не одобрена, переменную не заполняют: без неё на страницах нет ни
# мест под креативы, ни кнопки «Закрыть рекламу» — то есть фальшивой рекламы,
# на которую модерация ругается. Код мест из кабинета подключается после
# одобрения вместе с этой переменной.
VITE_ADS_CLIENT=

# Номер счётчика Яндекс.Метрики — только цифры, берётся из кабинета (там же,
# где адрес счётчика вида /watch/<номер>). Нужен, чтобы аудитория
# сайта стала видимой: Вебмастер посещаемости не показывает, а модератор РСЯ
# судит о площадке по реальной аудитории, отказ по ней стоит 30 дней. Переменная
# пустая → в собранном HTML нет ни тега, ни запроса к mc.yandex.ru (следит за
# этим verify:dist). Webvisor не включается намеренно: он записывает экран
# пользователя, а на конвертере в кадр попадают чужие файлы.
VITE_METRIKA_ID=

# Обычно не нужен: во время разработки запросы на /api проксирует vite
# (vite.config.js), а в проде фронтенд и API отдаются с одного домена — тогда
# запросы идут на относительные пути. Переменную задают, если API живёт на
# отдельном хосте: тогда он же становится целью прокси, и бэкенд обязан
# разрешить этот фронтенд в CORS_ALLOWED_ORIGINS.
# VITE_API_BASE_URL=http://127.0.0.1:8000
