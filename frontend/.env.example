# Абсолютный адрес продакшена — нужен для canonical, og:url, robots.txt и sitemap.xml.
# Без него статические теги и файлы не генерируются.
VITE_SITE_URL=https://example.ru

# Строка из кабинета Яндекс.Reкламы для файла ads.txt (публикуется как есть).
# Формат: <домен сети>, <ID издателя>, DIRECT, <контрольный параметр>
VITE_ADS_TXT=yandex.com, pub-XXXXXXXXXXXXX, DIRECT, XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
