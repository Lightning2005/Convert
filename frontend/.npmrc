# Официальный registry, а не зеркало из ~/.npmrc.
#
# Lock-файл хранит точные адреса `resolved`, и если собрать его через зеркало,
# npm ci в CI и на сервере начнёт качать пакеты оттуда. Проверено на реальном
# падении: зеркало отдало другой набор версий, и на Linux-раннере npm ci не
# нашла узлы @emnapi/*, которые на Windows не устанавливаются вообще.
registry=https://registry.npmjs.org/
